rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Core Authentication Safeguard
    function signedIn() {
      return request.auth != null;
    }

    // 2. Cost-Free Tenant Isolation Check (Uses Custom Token Claims)
    // Consumes 0 document reads! Instant evaluation.
    function isShopMember(shopId) {
      return signedIn() && (
        shopId == "shop-" + request.auth.uid ||
        request.auth.token.shopId == shopId ||
        // Profile reference fallback
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.currentShopId == shopId
      );
    }

    // 3. Cost-Free Ownership Check (Verifies token role claim)
    function isShopOwner(shopId) {
      return signedIn() && (
        shopId == "shop-" + request.auth.uid ||
        (request.auth.token.shopId == shopId && (request.auth.token.role == "owner" || request.auth.token.role == "shop_owner")) ||
        // Profile reference fallback
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.currentShopId == shopId &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "owner" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "shop_owner"))
      );
    }

    // 4. Users Profile Security (Blocks privilege escalation)
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
      allow create: if signedIn() && request.auth.uid == userId;
      // Prevent client-side role or tier manipulation unless done by an admin
      allow update: if signedIn() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'subscriptionStatus', 'pricingTier', 'currentShopId'])) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
      allow delete: if false;
    }
    
    // 4.5. SaaS System Notifications Center
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow update: if signedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']))
      );
      allow delete: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // 5. Shops Multi-Tenant Container
    match /shops/{shopId} {
      allow read: if isShopMember(shopId) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isShopOwner(shopId);
      allow delete: if false;

      // Shop members management
      match /members/{memberId} {
        allow read: if isShopMember(shopId);
        allow create, update: if isShopOwner(shopId);
        allow delete: if false;
      }

      // Secure Invoices ledger (Prevents fraudulent invoice deletions & updates)
      match /bills/{billId} {
        allow read: if (isShopMember(shopId) && resource.data.userId == request.auth.uid) || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
        allow create: if isShopMember(shopId)
          && request.resource.data.shopId == shopId
          && request.resource.data.userId == request.auth.uid;
        allow update: if isShopMember(shopId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        // Block invoice deletions entirely to prevent internal cash theft
        allow delete: if false;
      }

      // Customer files (Sanitized write access)
      match /customers/{customerId} {
        allow read: if isShopMember(shopId);
        allow create: if isShopMember(shopId);
        allow update: if isShopMember(shopId);
        allow delete: if isShopOwner(shopId);
      }

      // Category collections
      match /categories/{categoryId} {
        allow read, create, update, delete: if isShopMember(shopId);
      }

      match /subcategories/{subcategoryId} {
        allow read, create, update, delete: if isShopMember(shopId);
      }

      // Inventory Item access
      match /items/{itemId} {
        allow read, create, update, delete: if isShopMember(shopId) || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
      }

      // Structured Inventory Categories (Multi-level nesting)
      match /inventoryCategories/{categoryId} {
        allow read, create, update, delete: if isShopMember(shopId);

        match /subcategories/{subcategoryId} {
          allow read, create, update, delete: if isShopMember(shopId);

          match /items/{itemId} {
            allow read, create, update, delete: if isShopMember(shopId);
          }
        }
      }
    }
  }
}
